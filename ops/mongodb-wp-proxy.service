[Unit]
Description=MongoDB Wire Protocol Proxy
After=network.target

[Service]
Type=simple
User=mongodb-wp-proxy
Group=mongodb-wp-proxy
WorkingDirectory=/etc/mongodb-wp-proxy
EnvironmentFile=/etc/mongodb-wp-proxy/.env
# Log files are created 0640 so other local users cannot read logged commands
UMask=0027
ExecStart=/usr/bin/node bin/mongodb-wp-proxy.js --ndjson --oidc-mode \
  --issuer "${OIDC_ISSUER}" \
  --client-id "${OIDC_CLIENT_ID}" \
  --jwks-uri "${OIDC_JWKS_URI}" \
  --log-file "${LOG_FILE}" \
  ${LISTEN_HOST}:${LISTEN_PORT}

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
