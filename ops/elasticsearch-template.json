{
  "index_patterns": ["mongo-logs-*"],
  "template": {
    "settings": {
      "index.lifecycle.name": "mongo-logs-ilm-policy",
      "index.lifecycle.rollover_alias": "mongo-logs"
    },
    "mappings": {
      "properties": {
        "request": {
          "type": "flattened"
        },
        "response": {
          "type": "flattened"
        }
      }
    }
  },
  "priority": 100
}
