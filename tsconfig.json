{
  "ts-node": {
    "esm": false
  },
  "compilerOptions": {
    "esModuleInterop": true,
    "downlevelIteration": true,
    "sourceMap": true,

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,

    "declaration": true,
    "removeComments": true,
    "target": "es2022",
    "lib": ["es2024", "esnext.disposable"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./lib",
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"]
    }
  },
  "include": [
    "./src/**/*",
    "./test/**/*"
  ]
}
